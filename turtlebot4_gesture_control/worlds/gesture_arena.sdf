<?xml version="1.0" ?>
<sdf version="1.8"><world name="gesture_arena">
  <physics name="physics" type="ignored"><max_step_size>0.0333333333</max_step_size><real_time_factor>1</real_time_factor></physics>
  <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
  <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
  <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
  <!-- No simulated camera/LiDAR renderer: assignment uses laptop webcam. -->
  <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.2 0.2 -1</direction></light>
  <model name="ground"><static>true</static><link name="floor">
    <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></collision>
    <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
  </link></model>
  <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.2 0.3 0.4 1</background></scene>
  <gui fullscreen="false">
    <plugin filename="GzScene3D" name="3D View"><ignition-gui><title>Gesture Arena</title><property key="state" type="string">docked</property></ignition-gui><engine>ogre</engine><scene>scene</scene><ambient_light>0.7 0.7 0.7</ambient_light><camera_pose>4 -5 5 0 0.65 2.2</camera_pose></plugin>
    <plugin filename="WorldControl" name="World control"><ignition-gui><title>World control</title><property key="state" type="string">floating</property></ignition-gui><play_pause>true</play_pause><start_paused>false</start_paused></plugin>
  </gui>
</world></sdf>
